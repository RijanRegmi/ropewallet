{
  "name": "ropewallet-backend",
  "version": "1.0.0",
  "description": "RopeWallet Layered REST API Backend Service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); if(!fs.existsSync('dist/config')) fs.mkdirSync('dist/config',{recursive:true}); if(fs.existsSync('src/config')) fs.readdirSync('src/config').filter(f=>f.endsWith('.json')).forEach(f=>fs.copyFileSync('src/config/'+f, 'dist/config/'+f));\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "security:test": "tsx src/scripts/security_audit.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-mongo-sanitize": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "imapflow": "^1.0.180",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.2",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "otp-generator": "^4.0.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "stripe": "^18.0.0",
    "tronweb": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  }
}
